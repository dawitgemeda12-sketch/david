# =========================================================
# Stylish Backend — Environment Variable Template
# Copy this file to `.env` and fill in real values. NEVER
# commit an actual `.env` file with real secrets.
# =========================================================

NODE_ENV=production
PORT=3000

# PostgreSQL connection string (Prisma format).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT secrets — MUST be securely generated random strings (256-bit+)
# in production, stored in a secret manager (not committed, not in CI
# logs). Never reuse the same secret for access and refresh tokens.
JWT_ACCESS_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# AI provider (Anthropic). Leave blank to disable the AI Stylist
# feature gracefully (it will return a clear "not configured" error
# rather than crashing). Never expose this value to the Flutter client.
ANTHROPIC_API_KEY=""

# Weather (Open-Meteo requires no key; placeholder for a future paid provider)
WEATHER_API_KEY=""

# Object storage — "local" for development; swap to an S3-compatible
# driver (e.g. AWS S3, DigitalOcean Spaces, Cloudflare R2) in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="stylish-wardrobe-images"

# CORS — comma-separated list of allowed origins in production.
# NEVER use "*" in production once real user data is involved.
CORS_ORIGIN="https://app.stylish.example"

# Future: Google Sign-In
GOOGLE_CLIENT_ID=""
